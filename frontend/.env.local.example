# ─────────────────────────────────────────────────────────────────────────────
# EchoSphere — Zone 2 credentials (v6 §10.1)
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit it.
#
# Zone 2 is the Next.js server. It holds Agora app credentials and nothing else.
# LLM / STT / Jira / Slack / PagerDuty keys belong in Zone 3 (the Python
# backend, S3) behind the Proxy Action Layer — putting one here would change
# the blast radius of a Next.js compromise from "can talk on one bridge" to
# "can file tickets and page humans".
#
# A test in tests/s1-identity.test.ts fails the build if any of these names
# appear in the CLIENT tree.
# ─────────────────────────────────────────────────────────────────────────────

# ── Agora project — Console → Project Management ─────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Client-side SDK needs the App ID (and only the App ID). NEXT_PUBLIC_ is
# deliberate: this value is not a secret, the certificate is.
NEXT_PUBLIC_AGORA_APP_ID=

# ── Agora RESTful API — Console → RESTful API → Customer secrets ─────────────
# NOTE: this is a DIFFERENT credential pair from the app certificate above.
# Tokens are signed with the certificate; the Conversational AI management API
# authenticates with these. Conflating them is the most common setup failure.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ── OpenAI Realtime — the Fast Loop MLLM ─────────────────────────────────────
# Passed to Agora's Conversational AI Engine, which holds the socket to OpenAI.
# It is never sent to the browser.
OPENAI_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Shared secret for the /api/agent-events webhook. STRONGLY recommended: that
# endpoint is public by necessity and mints credentials. Without it the route
# logs a warning and accepts unauthenticated calls.
AGORA_WEBHOOK_SECRET=

# Python Roster Service (S2). Unset = in-process roster, which does not survive
# a dev-server reload.
ROSTER_SERVICE_URL=

# Override only for a non-default Agora region.
# AGORA_API_BASE=https://api.agora.io
