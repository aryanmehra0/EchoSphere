# ─────────────────────────────────────────────────────────────────────────────
# EchoSphere — Zone 2 credentials (v6 §10.1)
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit it.
#
# Zone 2 is the Next.js server. It holds Agora app credentials and nothing else.
# LLM / STT / Jira / Slack / PagerDuty keys belong in Zone 3 (the Python
# backend, S3) behind the Proxy Action Layer — putting one here would change
# the blast radius of a Next.js compromise from "can talk on one bridge" to
# "can file tickets and page humans".
#
# A test in tests/s1-identity.test.ts fails the build if any of these names
# appear in the CLIENT tree.
# ─────────────────────────────────────────────────────────────────────────────

# ── Agora project — Console → Project Management ─────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Client-side SDK needs the App ID (and only the App ID). NEXT_PUBLIC_ is
# deliberate: this value is not a secret, the certificate is.
NEXT_PUBLIC_AGORA_APP_ID=

# ── Agora RESTful API — Console → RESTful API → Customer secrets ─────────────
# NOTE: this is a DIFFERENT credential pair from the app certificate above.
# Tokens are signed with the certificate; the Conversational AI management API
# authenticates with these. Conflating them is the most common setup failure.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ── Fast Loop LLM — Groq ─────────────────────────────────────────────────────
# Echo's brain. Groq rather than OpenAI Realtime because no OpenAI key was
# available; Groq's API is OpenAI-chat-completions compatible with SSE, which is
# what Agora's custom-LLM integration requires. Verified against the live API.
#
# This makes the Fast Loop a CASCADE (Agora ASR → Groq → TTS) rather than
# audio-to-audio. See session_log.md for the two consequences that carries.
# Passed to Agora inside the create-agent payload; never sent to the browser.
GROQ_API_KEY=

# ── Fast Loop TTS — Echo's voice ─────────────────────────────────────────────
# Groq has no TTS and is not on Agora's vendor list, so the voice comes from
# elsewhere. Agora accepts: microsoft, elevenlabs, minimax, deepgram, cartesia,
# openai, humeai, rime, fishaudio, google, amazon, sarvam.
#
# ⚠️ Agora does NOT validate these params. A wrong param name still returns
# HTTP 200 RUNNING — and then Echo joins and never speaks, with no error
# anywhere. If Echo is silent, suspect this block first.
TTS_VENDOR=elevenlabs

# If TTS_VENDOR=elevenlabs  (adapter reads `key`)
ELEVENLABS_API_KEY=
# Optional. Defaults to a neutral voice.
ELEVENLABS_VOICE_ID=

# If TTS_VENDOR=sarvam  (adapter reads `api_subscription_key` — NOT `key`)
SARVAM_API_KEY=
# Optional. The speaker MUST be compatible with the pinned model (bulbul:v3).
# v2 voices such as `anushka` are rejected by v3. Sarvam lists the valid
# speakers in its 400 response, which is the quickest way to find a new one.
SARVAM_SPEAKER=
SARVAM_LANGUAGE=

# ── OpenAI — not currently used ──────────────────────────────────────────────
# If a key with gpt-4o-realtime-preview access ever appears, the Fast Loop can
# revert to true audio-to-audio: see the comment block in agent-config.ts. An
# OpenAI key also works as a TTS vendor on its own.
OPENAI_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Shared secret for the /api/agent-events webhook. STRONGLY recommended: that
# endpoint is public by necessity and mints credentials. Without it the route
# logs a warning and accepts unauthenticated calls.
AGORA_WEBHOOK_SECRET=

# Python Roster Service (S2). Unset = in-process roster, which does not survive
# a dev-server reload.
ROSTER_SERVICE_URL=

# Override only for a non-default Agora region.
# AGORA_API_BASE=https://api.agora.io

# ── Agora REST tools — PUBLIC url of the Slow Loop ───────────────────────────
# Agora's Conversational AI Engine calls tool endpoints from ITS OWN servers,
# so this must be reachable from the internet. `http://127.0.0.1:8000` resolves
# to Agora's machine, not yours.
#
# Leave BLANK for a local run: the agent is then created with tools DISABLED,
# which is deliberate. A tool that always fails is worse than an absent one —
# the model retries, collects errors, and answers from its own memory instead
# of reading the Ledger, which is the hallucination this product exists to
# prevent.
#
# You do not normally set these by hand. `.\start.ps1 -Tunnel` opens a
# cloudflared tunnel, generates the secret, writes both, and restarts the two
# services so they pick them up. The URL changes every run.
#
# By hand, if you prefer:
#     cloudflared tunnel --url http://localhost:8000
#     AGENT_TOOL_BASE_URL=https://<id>.trycloudflare.com
AGENT_TOOL_BASE_URL=

# Shared secret for requests arriving through the tunnel.
#
# ── NOT OPTIONAL ONCE A TUNNEL IS OPEN ──────────────────────────────────────
# A tunnel does not expose one endpoint. It exposes the whole Slow Loop —
# /incident/reset, /bridge/say and /approval/redeem included — and a random
# trycloudflare.com hostname is obscurity, not authentication. Without this,
# anyone who learns the URL can make Echo say anything on a live bridge.
#
# The backend requires it on any request whose Host is not local, and
# fail-closes: tunnel up with no secret set means every remote request is
# refused rather than served.
AGENT_TOOL_SECRET=
